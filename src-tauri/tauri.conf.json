{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CopyNotes",
  "version": "../package.json",
  "identifier": "com.copynotes.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "CopyNotes",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../mcp/server.js": "mcp/server.js",
      "../mcp/lib": "mcp/lib",
      "../mcp/node_modules": "mcp/node_modules"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzOUQ3RUQ4NkIxMjI2MDUKUldRRkpoSnIySDZkTThyaDJpTUU2OVZNSmI1elc0M1dLQVdvRysxRndqRFlnczVGWEVBTmJMZ2EK",
      "endpoints": [
        "https://github.com/Hhernanoliva/CopyNotes/releases/latest/download/latest.json"
      ]
    }
  }
}
