# CopyNotes — variables de entorno (spec 030 fase 2)
#
# Copiá este archivo como `.env` y poné los valores de tu proyecto Supabase.
# `.env` está en .gitignore: nunca se sube al repositorio.
#
# Sin estas variables CopyNotes funciona igual: queda 100% local, sin cuenta y
# sin nube. La sección "Nube" de Configuración muestra que no está configurada.

# Supabase › Project Settings › API › Project URL
PUBLIC_SUPABASE_URL=

# Supabase › Project Settings › API › Project API keys › anon public
# Es pública por diseño (viaja dentro de la app). Lo que protege los datos es el
# candado por usuario (RLS, ver supabase/schema.sql) más el cifrado en el
# dispositivo (src/lib/sync/records.ts).
PUBLIC_SUPABASE_ANON_KEY=

# Cómo se entra a la cuenta.
#
#   'true'  → código de 6 dígitos por email. Necesita SMTP con un dominio
#             verificado (ver supabase/README.md); si el proveedor no puede
#             enviar, nadie puede entrar.
#   resto   → email + contraseña, sin mails de por medio. Es el valor por
#             defecto y exige apagar "Confirm email" en Supabase.
#
# Los dos caminos están construidos: cambiar este valor es toda la migración.
PUBLIC_SUPABASE_EMAIL_CODE=false

# Supabase › Project Settings › API › Project API keys › service_role
#
# ESTA SÍ ES SECRETA: se saltea el candado por usuario. Va únicamente en el .env
# de una máquina de desarrollo y solo la usa `pnpm rls:check`, que crea y borra
# dos cuentas de prueba. NO la cargues en Vercel ni en ningún build.
SUPABASE_SERVICE_ROLE_KEY=
